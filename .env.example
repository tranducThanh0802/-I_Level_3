# Jira (chỉ đọc). Sao chép thành .env rồi điền JIRA_TOKEN. KHÔNG commit .env.
JIRA_BASE_URL=https://jira.apero.vn
JIRA_USER=            # tên đăng nhập Jira
JIRA_TOKEN=           # Personal Access Token (Jira > Profile > Personal Access Tokens)
JIRA_PROJECT=AIP555
JIRA_BOARD_ID=427

# GitHub (dùng để push repo này). Tài khoản sở hữu repo: tranducThanh0802.
GITHUB_USER=tranducThanh0802
GITHUB_TOKEN=         # Personal Access Token có quyền ghi repo (classic: repo; fine-grained: Contents read/write)
