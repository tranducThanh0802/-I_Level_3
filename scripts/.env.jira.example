# ====== Jira (jira.apero.vn) — KÉO bằng chứng "dùng agent" (READ-ONLY) ======
# Copy file này  ->  scripts/.env.jira   rồi ĐIỀN JIRA_TOKEN.
# File scripts/.env.jira đã được .gitignore — KHÔNG commit token (luật bảo mật A8).

JIRA_BASE_URL=https://jira.apero.vn

# Cách xác thực:
#   bearer = Personal Access Token  (khuyên dùng cho Jira Server/DC của Apero)
#   basic  = username/email + token (khi đó điền thêm JIRA_EMAIL)
JIRA_AUTH=bearer

# >>> DÁN TOKEN JIRA VÀO ĐÂY <<<
# Lấy token: jira.apero.vn -> avatar góc phải -> Profile -> Personal Access Tokens -> Create token
JIRA_TOKEN=

# Chỉ cần khi JIRA_AUTH=basic:
JIRA_EMAIL=

# Board đang xem: .../RapidBoard.jspa?projectKey=AIP555&rapidView=427
JIRA_PROJECT=AIP555
JIRA_BOARD=427
JIRA_FIX_VERSION=4.3.4

# AIP555 dùng SPRINT (không dùng fixVersion). "4.3.4" là tên sprint, id = 2820.
# Nếu đặt JIRA_SPRINT thì script lọc theo sprint (ưu tiên hơn fixVersion).
JIRA_SPRINT=2820

# (Tùy chọn) tách riêng phần AGENT làm — điền 1 trong 2 (nhãn hoặc tên người nhận là agent):
JIRA_AGENT_LABEL=
JIRA_AGENT_ASSIGNEE=

# (Tùy chọn) tự viết JQL — nếu đặt, sẽ bỏ qua PROJECT/FIX_VERSION ở trên:
# JIRA_JQL=project = AIP555 AND fixVersion = "4.3.4"
